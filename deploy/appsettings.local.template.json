// Файл настроек AtentisServer: %ProgramData%\AtentisServer\appsettings.local.json
// Служба читает его при КАЖДОМ запуске (изменили файл -> Restart-Service AtentisServer).
// Значения здесь важнее appsettings.json и переменных окружения. В файле допустимы комментарии //.
// Файл содержит пароли: права на него выдаёт install-service.ps1 (только SYSTEM, Administrators, служба). Не копируйте его в репозиторий и чаты.
{
  "ConnectionStrings": {
    // PostgreSQL. Для удалённого сервера используйте SSL Mode=VerifyFull. Если пароль содержит ; или ", возьмите его в одинарные кавычки: Password='...'
    "Postgres": "Host=localhost;Port=5432;Database=atentis;Username=atentis_app;Password=;SSL Mode=Prefer"
  },

  "Collector": {
    "Slots": [
      {
        "Name": "MICEX",          // не менять: попадает в базу как slot_id
        "Market": "SPOT",
        "Enabled": true,
        "Server": "",              // адрес сервера Atentis, например 10.0.0.1
        "Port": 0,                 // порт, например 7800
        "Login": "",
        "Password": "",
        "PublicKeyFile": ""        // файл открытого ключа для защищённого соединения; пусто = незащищённое
      },
      {
        "Name": "FORTS",
        "Market": "FUT",
        "Enabled": true,           // false - если срочный слот не нужен
        "Server": "",
        "Port": 0,
        "Login": "",
        "Password": "",
        "PublicKeyFile": ""
      }
    ]

    // Здесь же можно переопределить любые параметры из appsettings.json, например:
    // "ReconnectAfterSeconds": 120,
    // "Tables": [ ... ]   (внимание: список таблиц задаётся целиком)
  }
}
