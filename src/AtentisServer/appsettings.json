{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Npgsql": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "Postgres": ""
  },

  "Database": {
    "AutoMigrate": true,
    "CommandTimeoutSeconds": 30
  },

  "Monitoring": {
    "Url": "http://127.0.0.1:9464"
  },

  "Collector": {
    "ServerTimeZone": "Europe/Moscow",
    "FullSyncIntervalSeconds": 300,
    "BatchSize": 1000,
    "ReconnectAfterSeconds": 120,
    "MaxConsecutiveReconnectFailures": 10,
    "StatusIntervalSeconds": 15,

    "Slots": [
      {
        "Name": "MICEX",
        "Market": "SPOT",
        "Enabled": true,
        "Server": "",
        "Port": 0,
        "Login": "",
        "Password": "",
        "PublicKeyFile": "",
        "RefreshPeriodMs": 1000
      },
      {
        "Name": "FORTS",
        "Market": "FUT",
        "Enabled": true,
        "Server": "",
        "Port": 0,
        "Login": "",
        "Password": "",
        "PublicKeyFile": "",
        "RefreshPeriodMs": 1000
      }
    ],

    "Tables": [
      { "Name": "TRADES", "Enabled": true },
      { "Name": "ORDERS", "Enabled": true, "KeyFields": [ "OrderNo" ] },
      { "Name": "POSITIONS", "Enabled": true, "KeyFields": [ "ClientID", "TrdAccID" ] },
      { "Name": "FIRM_HOLDING_TOTAL", "Enabled": true, "KeyFields": [ "ClientID", "TrdAccID", "AccType", "SecCode" ] },
      { "Name": "SECURITIES", "Enabled": false, "MinIntervalSeconds": 60 }
    ]
  }
}
